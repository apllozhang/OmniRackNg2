# Development Compose only. Replace placeholders before starting services.
APP_ENV=development
POSTGRES_DB=omnirack_replica
POSTGRES_USER=omnirack_replica
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
POSTGRES_HOST_PORT=15435
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_LOCAL_ADMIN_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# A host-native Go process reads process environment, not this dotenv file.
# Its DATABASE_URL must use localhost:15435; Compose uses postgres:5432.
