APP_ENV=production
POSTGRES_DB=omnirack_replica
POSTGRES_USER=omnirack_replica
# 用至少 32 字节随机值替换，不使用空格；不得沿用示例文字。
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
JWT_EXPIRES_MINUTES=120
# 默认仅在本机访问；办公 Wi-Fi 通过企业受控 HTTPS 反向代理接入。
ASSET_HTTP_BIND=127.0.0.1
ASSET_HTTP_PORT=15174
